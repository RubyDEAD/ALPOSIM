@alposim_HostAddress = http://localhost:5181


GET {{alposim_HostAddress}}/weatherforecast/
Accept: application/json


### Login
# @name login
POST {{alposim_HostAddress}}/api/Auth/login
Content-Type: application/json

{
  "username": "test123",
  "password": "test123"
}

###

@token = {{login.response.body}}


### Register
POST {{alposim_HostAddress}}/api/Auth/register
Accept: application/json

###

### Get All Products
GET {{alposim_HostAddress}}/api/product
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Product by ID
GET {{alposim_HostAddress}}/api/product/YOUR-GUID-HERE
Accept: application/json
Authorization: Bearer {{token}}

###

### Create Product
POST {{alposim_HostAddress}}/api/product
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Sample Product",
  "price": 9.99,
  "description": "A test product"
}

###

### Update Product
PUT {{alposim_HostAddress}}/api/product/YOUR-GUID-HERE
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "name": "Updated Product",
  "price": 14.99,
  "description": "An updated product"
}

###

### Delete Product
DELETE {{alposim_HostAddress}}/api/product/YOUR-GUID-HERE
Accept: application/json
Authorization: Bearer {{token}}

###

### Get All Sales
GET {{alposim_HostAddress}}/api/sale
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Sale by ID
GET {{alposim_HostAddress}}/api/sale/YOUR-GUID-HERE
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Sales by Date Range
GET {{alposim_HostAddress}}/api/sale/range?startDate=2026-06-01&endDate=2026-06-30
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Sales by Payment Status (Paid)
GET {{alposim_HostAddress}}/api/sale/payment?payment=true
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Sales by Payment Status (Unpaid)
GET {{alposim_HostAddress}}/api/sale/payment?payment=false
Accept: application/json
Authorization: Bearer {{token}}

###

### Create Sale
POST {{alposim_HostAddress}}/api/sale
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "saleDate": "2026-06-08T15:30:00",
  "totalAmount": 1000.00,
  "payment": true
}

###

### Update Sale
PUT {{alposim_HostAddress}}/api/sale/YOUR-GUID-HERE
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "saleDate": "2026-06-08T15:30:00",
  "totalAmount": 1500.00,
  "payment": true
}

###

### Delete Sale
DELETE {{alposim_HostAddress}}/api/sale/YOUR-GUID-HERE
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Daily Report
GET {{alposim_HostAddress}}/api/report/daily?date=2026-06-08
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Weekly Report
GET {{alposim_HostAddress}}/api/report/weekly?month=6&year=2026
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Monthly Report
GET {{alposim_HostAddress}}/api/report/monthly?year=2026
Accept: application/json
Authorization: Bearer {{token}}

###

### Get Yearly Report
GET {{alposim_HostAddress}}/api/report/yearly
Accept: application/json
Authorization: Bearer {{token}}

###

### Add Item to Sale
POST {{alposim_HostAddress}}/api/sale/GUID-HERE/items
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "productId": "YOUR-PRODUCT-GUID",
  "quantity": 2
}

###

### Remove Item from Sale
DELETE {{alposim_HostAddress}}/api/sale/GUID-HERE/items/ITEM-GUID-HERE
Authorization: Bearer {{token}}

###

### Update Item Quantity
PATCH {{alposim_HostAddress}}/api/sale/GUID-HERE/items/ITEM-GUID-HERE
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "quantity": 5
}

###


